APP_NAME=Sentinel Backend
DATABASE_URL=sqlite:///./sentinel.db
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=true

# MySQL: DATABASE_URL=mysql+pymysql://user:password@host:3306/sentinel
# Triển khai thật: SEED_DEMO_DATA=false và tạo Admin đầu tiên:
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
AUTH_SESSION_HOURS=24
SANDBOX_IMAGE=sentinel-test-runner:local
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5

# Chỉ gửi source khi người dùng bấm thao tác AI.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

