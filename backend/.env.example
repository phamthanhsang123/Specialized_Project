APP_NAME=Sentinel Backend
DATABASE_URL=sqlite:///./sentinel.db
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=true

# MySQL: DATABASE_URL=mysql+pymysql://user:password@host:3306/sentinel
# Triển khai thật: SEED_DEMO_DATA=false và tạo Admin đầu tiên:
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
AUTH_SESSION_HOURS=24
SANDBOX_IMAGE=sentinel-test-runner:local
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5

# Chỉ gửi source khi người dùng bấm thao tác AI.
# Gemini có gói API miễn phí cho một số model. Tạo khóa tại https://aistudio.google.com/apikey
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI API tính phí riêng với tài khoản ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Grok trên ứng dụng có gói miễn phí, nhưng xAI API tính phí theo token.
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Tương thích ngược với cấu hình OpenAI cũ; nên dùng OPENAI_* ở trên cho cài đặt mới.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

